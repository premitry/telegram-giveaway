# Copy this file to `.dev.vars` for local development (`wrangler dev`).
# NEVER commit `.dev.vars` — it is git-ignored.

# Telegram bot token from @BotFather
BOT_TOKEN="123456:ABC-DEF_your_bot_token_here"

# Secret token sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
# Must match the value used when calling setWebhook. Any 1-256 char A-Z a-z 0-9 _ - string.
TELEGRAM_WEBHOOK_SECRET="change_me_to_a_long_random_string"
